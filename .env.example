# Runtime
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# Data stores (docker compose maps these to localhost)
DATABASE_URL=postgresql://receptionai:receptionai_password@127.0.0.1:5433/receptionai_db?schema=public
# DIRECT_URL=
REDIS_URL=redis://127.0.0.1:6380

# Must be at least 32 characters. Used for cookies, slot tokens, and OAuth state.
SESSION_SECRET=replace_with_a_random_session_secret_at_least_32_chars

# OpenAI — optional locally. Without a key, embeddings and categorizer use mocks.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# REALTIME_VOICE_ENABLED=true

# Communications — mock providers work without credentials
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=notifications@localhost
EMAIL_FROM_NAME=ReceptionAI
# SMS_FROM_NUMBER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_AUTH_TOKEN=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Google Calendar — optional. The internal demo calendar is the default.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-calendar/callback
