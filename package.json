{
  "name": "reception-ai",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source multi-tenant platform for AI voice receptionists with workspace RBAC, RAG, scheduling, and a confirmation-gated tool gateway.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @receptionai/web dev",
    "dev:api": "pnpm --filter @receptionai/api dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @receptionai/db generate",
    "db:migrate": "pnpm --filter @receptionai/db migrate",
    "db:push": "pnpm --filter @receptionai/db push",
    "db:seed": "pnpm --filter @receptionai/db seed",
    "db:studio": "pnpm --filter @receptionai/db studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
